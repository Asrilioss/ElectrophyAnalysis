# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.venv_build/
venv/
env/

# --- PyInstaller build artefacts ---
# The .exe is distributed as a Release asset, never committed: it is ~35 MB and
# would bloat every clone forever.
build/
dist/
*.manifest

# --- Editor / OS ---
.vscode/
.idea/
.spyproject/
.spyderproject/
.DS_Store
Thumbs.db
desktop.ini

# --- Editing debris ---
# Spyder and some editors leave these behind on crash.
*.tmp
*.tmp.*
*~
~$*

# --- Run outputs ---
# Pipelines write timestamped result folders next to where they are launched.
# Nothing generated by a run belongs in version control.
results_*/
runinfo/
*.log
QC_Plots/

# --- Data ---
# Raw recordings are large and are distributed via Zenodo, not git.
# The small curated example set under examples/data/ is the deliberate
# exception and is force-added.
*.abf
!examples/data/*.abf

# Generated workbooks and figures, except the archived synthetic-validation
# output, which is a versioned artefact of the paper.
*.xlsx
!validation/AUC_Validation_Synthetique_V3.xlsx
!examples/**/*.xlsx
